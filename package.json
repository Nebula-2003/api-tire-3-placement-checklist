{
  "name": "theTire3CheckList",
  "scripts": {
    "dev": "wrangler dev",
    "db:migration:local": "npx wrangler d1 migrations apply thetire3checklist --local",
    "db:migration:prod": "npx wrangler d1 migrations apply thetire3checklist --remote",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:gen": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.19.9",
    "@hono/zod-validator": "^0.2.2",
    "@scalar/hono-api-reference": "^0.9.7",
    "@scalar/openapi-to-markdown": "^0.2.17",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.8.3",
    "zod": "^3.25.74",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.0.10",
    "drizzle-kit": "^0.31.4",
    "wrangler": "^4.23.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "vue-demi"
    ]
  }
}